# UTDE frontend environment (all optional).
#
# The app runs fully in the browser — the toolpath engine executes in Pyodide
# and STEP is parsed with opencascade.js — so there is NO backend URL to set.

# Deploy base path. Prefer the VITE_BASE build env (see vite.config.js); set to
# your repo name for GitHub Pages project sites, e.g. "/UTDE/".
# VITE_BASE=/

# Where the Pyodide runtime (and its numpy/scipy/pyyaml packages) load from.
# Unset  -> the jsDelivr CDN (default; requires network on first load).
# Self-hosted / offline: run `npm run fetch-pyodide` to populate public/pyodide/,
# then point this at that same-origin path (respects VITE_BASE):
# VITE_PYODIDE_INDEX_URL=/pyodide/
